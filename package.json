{
  "name": "wtc-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build:kit": "bash kit/build.sh",
    "test": "bun test",
    "build": "bun run build:kit && bun build packages/wtc/src/cli/main.ts --compile --outfile dist/wtc",
    "typecheck": "tsc -b packages/wtc"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^7.0.2"
  }
}
