{
  "name": "@lyonbot/wtc",
  "version": "0.1.2",
  "description": "Run one long-lived docker container per git worktree/branch, with shared installs and SOCKS tunnels",
  "license": "MIT",
  "author": "lyonbot",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lyonbot/wtc.git",
    "directory": "packages/wtc"
  },
  "homepage": "https://github.com/lyonbot/wtc#readme",
  "bugs": {
    "url": "https://github.com/lyonbot/wtc/issues"
  },
  "keywords": [
    "docker",
    "worktree",
    "git-worktree",
    "dev-environment",
    "container",
    "bun",
    "cli"
  ],
  "type": "module",
  "bin": {
    "wtc": "bin/wtc.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./src/index.ts"
    },
    "./setup": {
      "types": "./dist/src/setup/index.d.ts",
      "default": "./src/setup/index.ts"
    }
  },
  "engines": {
    "bun": ">=1.3.6"
  },
  "files": [
    "bin",
    "src",
    "skill",
    "kit",
    "docs",
    "dist/src/**/*.d.ts"
  ],
  "dependencies": {
    "commander": "12",
    "zod": "3"
  },
  "scripts": {
    "prepack": "bash ../../kit/build.sh && bun scripts/sync-docs.ts && tsc -b ."
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
